# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# internal dev docs & local automation — kept out of the public repo
/CLAUDE.md
/docs/
/.claude/
/scripts/freshness-refresh.sh

# generated public mirror repo (awesome-agentscamp) — built from src/content,
# pushed to its own GitHub repo; never tracked here (matches cli/content)
/mirror/

# typescript
*.tsbuildinfo
next-env.d.ts

# Internal link-audit tool (local-only, like freshness-refresh.sh)
scripts/audit-links.ts
